DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5432/social_reply
REDIS_URL=redis://localhost:6379/0
CHATWOOT_WEBHOOK_SECRET=dev-local-secret
CHATWOOT_SIGNATURE_TOLERANCE_SECONDS=300
TENANT_ID=default

# --- Plan 2c：OpenAI（用户填写真实值） ---
LLM_PROVIDER=stub            # 改为 openai 启用真实 LLM
OPENAI_API_KEY=              # sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# --- 真实 Chatwoot（用户填写真实值） ---
CHATWOOT_BASE_URL=http://localhost:3000
CHATWOOT_API_TOKEN=          # api_access_token

# --- 平台账号管理控制面 ---
# CONTROL_API_KEY 只供服务间 Provisioning API 使用，绝不能放到浏览器。
CONTROL_API_KEY=
# 内置 /admin 第一版管理员会话；生产建议在其前方部署 OIDC/MFA 身份感知代理。
ADMIN_SESSION_SECRET=       # 至少 32 字节强随机值
ADMIN_USERNAME=admin
ADMIN_PASSWORD=            # 强密码
ADMIN_ALLOWED_TENANTS=default  # 逗号分隔；内置管理员仅能管理这些租户
# 平台 webhook 对外稳定域名；后台表单不允许覆盖，防止凭证被发往任意地址。
PUBLIC_BASE_URL=https://reply.example.com
# API 收到的账号凭证会落到该目录，并以 file:// 引用写入数据库。
# 生产建议挂载加密持久卷；后续可替换为 Vault/云 Secret Manager。
ACCOUNT_SECRETS_ROOT=.secrets/accounts
