# Local single-process smoke template only. TESTING=true runs actor fallbacks inline and uses
# StubBroker/stub LLM; it does not exercise the production Redis/Dramatiq process boundary.
# Production must use deploy/vps/.env.example.
TESTING=true
DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5432/social_reply
REDIS_URL=redis://localhost:6379/0
TENANT_ID=default

# --- Optional Chatwoot Bridge; direct mode keeps this false ---
CHATWOOT_ENABLED=false
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_SIGNATURE_TOLERANCE_SECONDS=300
CHATWOOT_BASE_URL=http://localhost:3000
CHATWOOT_API_TOKEN=

# --- Local decision runtime ---
# stub LLM is allowed only because TESTING=true. Knowledge retrieval stays off below so the
# smoke profile never attempts an external embedding request with an empty API key.
LLM_PROVIDER=stub
PROMPT_VERSION=v0-stub
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=30

# --- Platform account control plane ---
# Development values below are public placeholders and must never be reused in production.
CONTROL_API_KEY=dev-control-key
ADMIN_SESSION_SECRET=dev-admin-session-secret-at-least-32-bytes
ADMIN_USERNAME=admin
ADMIN_PASSWORD=dev-admin-password
ADMIN_ALLOWED_TENANTS=default
PUBLIC_BASE_URL=http://localhost:8000

# X stacks. XChat remains experimental, so new environments keep it disabled.
X_LEGACY_DM_ENABLED=true
X_ACTIVITY_ENABLED=true
XCHAT_ENABLED=false
# X OAuth 1.0a Consumer Keys. Legacy DM or XChat requires
# Read and write and Direct message permission.
X_API_KEY=
X_API_SECRET=
X_OAUTH_LEGACY_STATE_WRITE=false

# Future Meta messaging integrations are disabled in new environments.
# API, Worker, and Scheduler must use the same values.
FACEBOOK_MESSENGER_ENABLED=false
INSTAGRAM_MESSAGING_ENABLED=false
WHATSAPP_ENABLED=false

# Facebook Login App for Facebook Pages and Page-linked Instagram accounts.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
META_VERIFY_TOKEN=

# Standalone Instagram Login App.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Falls back to META_VERIFY_TOKEN when empty.
INSTAGRAM_VERIFY_TOKEN=
# Scheduler token/subscription reconciliation interval.
META_HEALTH_CHECK_INTERVAL_SECONDS=600

# Public development-only Fernet key. Generate a private production key with:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
PLATFORM_SECRET_KEYS=Wm5wbamjBFvTmkGIU2NskIKCrJfsb4AdUBDZR-m1-CM=
# Legacy file:// credential migration only; new credentials are encrypted in PostgreSQL.
ACCOUNT_SECRETS_ROOT=.secrets/accounts

# Knowledge retrieval and conversation history.
KNOWLEDGE_RETRIEVAL_ENABLED=false
KNOWLEDGE_VERBATIM_REPLY=false
KNOWLEDGE_MIN_SIMILARITY=0.5
KNOWLEDGE_TOP_K=3
REQUIRE_KNOWLEDGE=false
CONVERSATION_HISTORY_LIMIT=20
CONVERSATION_HISTORY_MAX_CHARS=12000

# Module-level X reconciliation intervals, read once at process import.
X_DM_POLL_INTERVAL_SECONDS=90
X_WEBHOOK_CHECK_INTERVAL_SECONDS=600
XCHAT_POLL_INTERVAL_SECONDS=900
XCHAT_MAX_CONVERSATIONS_PER_POLL=10
XCHAT_SUBSCRIPTION_CHECK_INTERVAL_SECONDS=600
