DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5432/social_reply
REDIS_URL=redis://localhost:6379/0
CHATWOOT_WEBHOOK_SECRET=dev-local-secret
CHATWOOT_SIGNATURE_TOLERANCE_SECONDS=300
TENANT_ID=default

# --- Plan 2c：OpenAI（用户填写真实值） ---
LLM_PROVIDER=openai          # 生产禁止 stub；测试由 TESTING=true 单独启用
OPENAI_API_KEY=              # sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# --- 真实 Chatwoot（用户填写真实值） ---
CHATWOOT_BASE_URL=http://localhost:3000
CHATWOOT_API_TOKEN=          # api_access_token

# --- 平台账号管理控制面 ---
# CONTROL_API_KEY 只供服务间 Provisioning API 使用，绝不能放到浏览器。
CONTROL_API_KEY=
# /admin 使用 PostgreSQL 服务端会话；浏览器 Cookie 只保存 opaque token。
ADMIN_SESSION_SECRET=       # 至少 32 字节强随机值；所有 API 实例必须一致
# bootstrap 超级管理员（不写入数据库），用于在 /admin/users 创建普通用户。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=            # 强密码
ADMIN_ALLOWED_TENANTS=default  # 逗号分隔；超级管理员可管理这些租户
# 平台 webhook 对外稳定域名；后台表单不允许覆盖，防止凭证被发往任意地址。
PUBLIC_BASE_URL=https://reply.example.com
# X OAuth 1.0a App 凭证（与 Postiz 相同）：X Developer Portal → Keys and Tokens → Consumer Keys。
# App permissions=Read and Write，Type of App=Native App；回调登记：
# ${PUBLIC_BASE_URL}/admin/oauth/x/callback
# Shared Activity webhook（tenant_id=default）: ${PUBLIC_BASE_URL}/webhooks/x/x_oauth_default
# 其他 tenant 的后缀按 tenant_id 生成。
X_API_KEY=
X_API_SECRET=

# Facebook Login App：Facebook Page 与 Page 关联的 Instagram 专业账号共享。
# OAuth callback: ${PUBLIC_BASE_URL}/admin/oauth/meta/callback
# Webhook URL（tenant_id=default）: ${PUBLIC_BASE_URL}/webhooks/meta/meta_oauth_default
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
META_VERIFY_TOKEN=

# Instagram Login 独立 App：无需 Facebook Page，仅支持 Instagram 专业账号。
# OAuth callback: ${PUBLIC_BASE_URL}/admin/oauth/instagram/callback
# Webhook URL（tenant_id=default）: ${PUBLIC_BASE_URL}/webhooks/meta/instagram_oauth_default
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# 留空时回退使用 META_VERIFY_TOKEN。
INSTAGRAM_VERIFY_TOKEN=

# 平台凭证使用应用层 Fernet 加密后存入共享数据库。第一把用于新写入，后续键用于解密旧数据。
# 生成：python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
PLATFORM_SECRET_KEYS=
# 仅保留给旧 file:// 凭证迁移工具使用；新凭证不再写本地文件。
ACCOUNT_SECRETS_ROOT=.secrets/accounts

# 知识检索/原文模板回复
KNOWLEDGE_RETRIEVAL_ENABLED=true
KNOWLEDGE_VERBATIM_REPLY=true
KNOWLEDGE_MIN_SIMILARITY=0.5
KNOWLEDGE_TOP_K=3
REQUIRE_KNOWLEDGE=false
X_DM_POLL_INTERVAL_SECONDS=90
