# Reply Core · VPS 生产环境变量模板
# 用法：cp .env.example .env && chmod 600 .env，然后逐项填写。
# 从 Railway 迁移时，标注“原样复制”的值必须与 Railway Variables 完全一致，
# 尤其 PLATFORM_SECRET_KEYS；填错会导致已有平台凭证无法解密。
# DATABASE_URL / REDIS_URL / SERVICE_ROLE / PORT 由 docker-compose.yml 注入。

# ---- 基础设施 ----
PG_PASSWORD=
# Cloudflare Tunnel token；deploy/vps/docker-compose.yml 会在缺失时直接失败。
CLOUDFLARE_TUNNEL_TOKEN=

# ---- 核心 ----
TESTING=false
TENANT_ID=default
PUBLIC_BASE_URL=https://relay.example.com
# [Railway 原样复制] Fernet 密钥，逗号分隔；首键加密，后续键用于解密旧值。
PLATFORM_SECRET_KEYS=
# [Railway 原样复制] 仅供服务间 Provisioning API 使用。
CONTROL_API_KEY=

# ---- LLM ----
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- Admin 后台 ----
# bootstrap 超级管理员，用于在 /admin/users 创建单 Tenant 普通用户。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 至少 32 字节随机串；所有 API 实例保持一致。服务端会话存 PostgreSQL。
ADMIN_SESSION_SECRET=
ADMIN_ALLOWED_TENANTS=default

# ---- Chatwoot 集成 ----
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_SIGNATURE_TOLERANCE_SECONDS=300

# ---- 知识检索 ----
KNOWLEDGE_RETRIEVAL_ENABLED=true
KNOWLEDGE_VERBATIM_REPLY=true
KNOWLEDGE_MIN_SIMILARITY=0.5
KNOWLEDGE_TOP_K=3
REQUIRE_KNOWLEDGE=false
# 最近历史消息条数与总字符预算；设 limit=0 可关闭向外部 LLM 发送历史上下文。
CONVERSATION_HISTORY_LIMIT=20
CONVERSATION_HISTORY_MAX_CHARS=12000

# ---- X 平台轮询/巡检 ----
X_DM_POLL_INTERVAL_SECONDS=90
X_WEBHOOK_CHECK_INTERVAL_SECONDS=600
# X Developer Portal Consumer Keys（不是 OAuth 2.0 Client ID/Secret）。
# App permissions: Read and write and Direct message；App type: Web App。
# Callback URL: ${PUBLIC_BASE_URL}/admin/oauth/x/callback
X_API_KEY=
X_API_SECRET=
# OAuth state key 两阶段滚动迁移专用；常态 false，phase 1 临时 true。
X_OAUTH_LEGACY_STATE_WRITE=false

# ---- Meta / Instagram OAuth ----
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
META_VERIFY_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# 留空时回退使用 META_VERIFY_TOKEN。
INSTAGRAM_VERIFY_TOKEN=
